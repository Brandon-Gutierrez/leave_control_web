# Despliegue de la web. Copia este archivo a .env y completa los valores. .env NO se versiona.

# --- Acceso público ----------------------------------------------------------
# Dirección con la que se entra, sin https:// (el dominio que asigne Comteco;
# mientras tanto, la IP del servidor). Si el HTTPS no va en el 443, añade el puerto
# (ej. salidas.comteco.com.bo:9443). Debe coincidir con PUBLIC_HOST en el .env del backend.
PUBLIC_HOST=localhost
HTTP_PORT=80
HTTPS_PORT=443
# Proxy de la empresa delante de este servidor (IP o CIDR) cuyo X-Forwarded-For se acepta.
# 127.0.0.1/32 = ninguno: se usa la IP de la conexión.
TRUSTED_PROXY=127.0.0.1/32

# --- API ----------------------------------------------------------------------
# A dónde se reenvían /api y /sanctum: http(s)://host[:puerto], sin barra final.
# Mismo servidor (red compartida): http://control-salidas-api
# Otro servidor: https://IP-o-nombre:8443
BACKEND_URL=http://control-salidas-api
# Red de Docker compartida con el backend.
SHARED_NETWORK=control-salidas

# --- Compilación -----------------------------------------------------------------
FLUTTER_VERSION=3.47.0
